# Copia este archivo como .env y completa tus credenciales de https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Debe coincidir exactamente con la Redirect URI registrada en tu app de Kick
KICK_REDIRECT_URI=http://localhost:8080/auth/callback
# Permisos a pedir (opcional; deben estar habilitados en tu app)
KICK_SCOPES=user:read channel:read chat:write
# Opcional: archivo donde se guardan los tokens
# KICK_TOKEN_FILE=.kick_tokens.json
# Opcional: omite la consulta a kick.com si esta te devuelve 403
# KICK_CHANNEL_ID=
# KICK_CHATROOM_ID=
